
def is_win(board):
    directions = [(1, 0), (0, 1), (1, 1), (-1, 1)]
    for x in range(10):
        for y in range(10):
            if board[x][y] == 'W':
                for dx, dy in directions:
                    count = 1
                    for i in range(1, 5):
                        nx, ny = x + dx * i, y + dy * i
                        if 0 <= nx < 10 and 0 <= ny < 10 and board[nx][ny] == 'W':
                            count += 1
                        else:
                            break
                    if count == 5:
                        return True
    return False


result = []


def count_winning_moves(board, direction, row):
    win_moves = 0
    global result
    # 직접 흰돌을 둬서 이기는 경우의 수 확인
    for x in range(10):
        for y in range(10):
            if board[x][y] == '.':
                board[x][y] = 'W'
                if is_win(board):
                    if (x, y, direction, row) not in result:
                        result.append((x, y, direction, row))
                        win_moves += 1
                board[x][y] = '.'
    return win_moves


def simulate(board):
    # 보드의 각 행을 문자열에서 문자 리스트로 변환
    board = [list(row) for row in board]

    total_moves = count_winning_moves(board, '가로', 0)

    for i in range(10):
        # 가로줄 지우기
        saved_row = board[i].copy()
        board[i] = ['.'] * 10
        total_moves += count_winning_moves(board, '세로', str(i))
        board[i] = saved_row

    for i in range(10):
        # 세로줄 지우기
        saved_col = [board[j][i] for j in range(10)]
        for j in range(10):
            board[j][i] = '.'
        total_moves += count_winning_moves(board, '가로', str(i))
        for j in range(10):
            board[j][i] = saved_col[j]
    return total_moves


# 격자판 입력
board = []
for _ in range(10):
    board.append(input())

print(simulate(board))
